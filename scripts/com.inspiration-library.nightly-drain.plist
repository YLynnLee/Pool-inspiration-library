<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template for an opt-in nightly drain. See docs/agents/nightly-drain.md for
  setup steps — this file is not live until copied to ~/Library/LaunchAgents
  and loaded, and the two REPO_PATH_HERE placeholders below must be replaced
  with the absolute path to this checkout first.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.inspiration-library.nightly-drain</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>REPO_PATH_HERE/scripts/nightly-drain.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- launchd's own diagnostic output — separate from the human-readable
         record the drain itself appends to .scratch/curation-loop/nightly-drain.log. -->
    <key>StandardOutPath</key>
    <string>REPO_PATH_HERE/.scratch/curation-loop/launchd.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>REPO_PATH_HERE/.scratch/curation-loop/launchd.stderr.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
